{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding: clamp(28px, 5vw, 72px) clamp(18px, 4vw, 56px);
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }
  .ai-editorial-{{ ai_gen_id }}__inner { max-width: 1240px; margin: 0 auto; }
  .ai-editorial-{{ ai_gen_id }}__eyebrow { margin: 0 0 16px; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; }
  .ai-editorial-{{ ai_gen_id }}__heading { max-width: 900px; margin: 0 0 28px; font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }}; font-size: clamp(40px, 8vw, {{ block.settings.heading_size }}px); line-height: .98; font-weight: 500; letter-spacing: -.045em; }
  .ai-editorial-{{ ai_gen_id }}__layout { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(220px, .8fr); gap: clamp(24px, 5vw, 64px); align-items: end; }
  .ai-editorial-{{ ai_gen_id }}__media { display: block; overflow: hidden; background: #e9e5df; }
  .ai-editorial-{{ ai_gen_id }}__media img, .ai-editorial-{{ ai_gen_id }}__media svg { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  .ai-editorial-{{ ai_gen_id }}__placeholder { position: relative; }
  .ai-editorial-{{ ai_gen_id }}__placeholder svg { color: #766f68; }
  .ai-editorial-{{ ai_gen_id }}__empty { position: absolute; inset: auto 12px 12px; margin: 0; padding: 10px 12px; background: #fff; color: #262626; font-size: 13px; text-align: center; }
  .ai-editorial-{{ ai_gen_id }}__caption { margin: 10px 0 0; font-size: 12px; line-height: 1.5; opacity: .8; }
  .ai-editorial-{{ ai_gen_id }}__story { border-top: 1px solid currentColor; padding-top: 18px; }
  .ai-editorial-{{ ai_gen_id }}__dek { margin: 0 0 22px; font-size: clamp(18px, 2vw, 23px); line-height: 1.4; }
  .ai-editorial-{{ ai_gen_id }}__body { font-size: 15px; line-height: 1.75; }
  .ai-editorial-{{ ai_gen_id }}__body p { margin: 0 0 14px; }
  .ai-editorial-{{ ai_gen_id }}__link { display: inline-block; margin-top: 10px; padding-bottom: 4px; border-bottom: 1px solid currentColor; color: inherit; font-size: 13px; font-weight: 600; text-decoration: none; }
  .ai-editorial-{{ ai_gen_id }}__link:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  @media screen and (max-width: 749px) {
    .ai-editorial-{{ ai_gen_id }} { width: 100%; }
    .ai-editorial-{{ ai_gen_id }}__layout { grid-template-columns: 1fr; align-items: start; }
    .ai-editorial-{{ ai_gen_id }}__heading { margin-bottom: 22px; }
  }
{% endstyle %}

<div class="ai-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-{{ ai_gen_id }}__inner">
    {% if block.settings.kicker != blank %}<p class="ai-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.kicker | escape }}</p>{% endif %}
    {% if block.settings.heading != blank %}<h2 class="ai-editorial-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    <div class="ai-editorial-{{ ai_gen_id }}__layout">
      <div>
        {% if block.settings.image != blank %}
          <figure style="margin:0">
            <div class="ai-editorial-{{ ai_gen_id }}__media"><img src="{{ block.settings.image | image_url: width: 1800 }}" alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}"></div>
            {% if block.settings.caption != blank %}<figcaption class="ai-editorial-{{ ai_gen_id }}__caption">{{ block.settings.caption | escape }}</figcaption>{% endif %}
          </figure>
        {% else %}
          <div class="ai-editorial-{{ ai_gen_id }}__media ai-editorial-{{ ai_gen_id }}__placeholder">
            {{ 'image' | placeholder_svg_tag }}
            <p class="ai-editorial-{{ ai_gen_id }}__empty">Add an editorial image in the block settings.</p>
          </div>
        {% endif %}
      </div>
      <div class="ai-editorial-{{ ai_gen_id }}__story">
        {% if block.settings.dek != blank %}<p class="ai-editorial-{{ ai_gen_id }}__dek">{{ block.settings.dek | escape }}</p>{% endif %}
        {% if block.settings.body != blank %}<div class="ai-editorial-{{ ai_gen_id }}__body">{{ block.settings.body }}</div>{% endif %}
        {% if block.settings.link_label != blank and block.settings.link_url != blank %}<a class="ai-editorial-{{ ai_gen_id }}__link" href="{{ block.settings.link_url }}">{{ block.settings.link_label | escape }}</a>{% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial layout",
  "settings": [
    { "type": "header", "content": "Story" },
    { "type": "text", "id": "kicker", "label": "Eyebrow", "default": "The art of atmosphere" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "A slower kind of glow" },
    { "type": "text", "id": "dek", "label": "Standfirst", "default": "Thoughtful rituals, warm light, and the quiet beauty of coming home." },
    { "type": "richtext", "id": "body", "label": "Article text", "default": "<p>Every candle begins with a moment worth keeping. Discover considered scents and small-batch details made to bring a little more meaning to the everyday.</p>" },
    { "type": "image_picker", "id": "image", "label": "Feature image" },
    { "type": "text", "id": "caption", "label": "Image caption", "default": "Made for unhurried evenings and everyday rituals." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore the collection" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "header", "content": "Appearance" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "heading_size", "label": "Headline size", "min": 48, "max": 96, "step": 4, "unit": "px", "default": 72 },
    { "type": "font_picker", "id": "heading_font", "label": "Headline font", "default": "dm_sans_n5" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F4F4F4" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#262626" }
  ],
  "presets": [{ "name": "Editorial layout" }],
  "tag": null,
  "class": "editorial-layout-block"
}
{% endschema %}