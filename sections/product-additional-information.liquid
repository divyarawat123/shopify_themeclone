
{% liquid
  assign product_item = product
  assign has_information = false

  if product_item.metafields.custom.weight_info != blank or product_item.metafields.custom.dimensions != blank or product_item.metafields.custom.size != blank or product_item.metafields.custom.fragrance_by_mood != blank or product_item.metafields.custom.fragrance_by_room != blank or product_item.metafields.custom.lighting_hours != blank or product_item.metafields.custom.color != blank or product_item.metafields.custom.fragrance_family != blank or product_item.metafields.custom.fragrance_subfamily != blank
    assign has_information = true
  endif
%}

<section id="product-info-{{ section.id }}" class="product-info-tabs">
  <div class="product-info-tab-header" role="tablist">
    <button
      type="button"
      class="product-info-tab active"
      role="tab"
      aria-selected="true"
      aria-controls="product-info-panel-{{ section.id }}"
      data-tab="additional"
    >
      {{ section.settings.additional_heading | escape }}
    </button>

    <button
      type="button"
      class="product-info-tab"
      role="tab"
      aria-selected="false"
      aria-controls="product-reviews-panel-{{ section.id }}"
      data-tab="reviews"
    >
      {{ section.settings.reviews_heading | escape }}
      ({{ product_item.metafields.reviews.rating_count | default: 0 }})
    </button>
  </div>

  <div
    id="product-info-panel-{{ section.id }}"
    class="product-info-panel"
    role="tabpanel"
    data-panel="additional"
  >
    {% if has_information %}
      <div class="product-info-table-wrapper">
        <table class="product-info-table">
          <tbody>
            {% comment %} {% if product_item.metafields.custom.weight_info != blank %}
              <tr>
                <th scope="row">Weight</th>
                <td>{{ product_item.metafields.custom.weight_info.value | escape }}</td>
              </tr>
            {% endif %} {% endcomment %}

            {% if product_item.metafields.custom.dimensions != blank %}
              <tr>
                <th scope="row">Dimensions</th>
                <td>{{ product_item.metafields.custom.dimensions.value | escape }}</td>
              </tr>
            {% endif %}

            {% if product_item.metafields.custom.size != blank %}
              <tr>
                <th scope="row">Size</th>
                <td>{{ product_item.metafields.custom.size.value | escape }}</td>
              </tr>
            {% endif %}

            {% if product_item.metafields.custom.lighting_hours != blank %}
              <tr>
                <th scope="row">Lighting Hours (Hrs)</th>
                <td>{{ product_item.metafields.custom.lighting_hours.value | escape }}</td>
              </tr>
            {% endif %}

            {% comment %} {% if product_item.metafields.custom.fragrance_by_mood != blank %}
              <tr>
                <th scope="row">Weight</th>
                <td>{{ product_item.metafields.custom.fragrance_by_mood.value | escape }}</td>
              </tr>
            {% endif %}

            {% if product_item.metafields.custom.fragrance_by_room != blank %}
              <tr>
                <th scope="row">Fragrance By Room</th>
                <td>{{ product_item.metafields.custom.fragrance_by_room.value | escape }}</td>
              </tr>
            {% endif %} {% endcomment %}

            

            {% comment %} {% if product_item.metafields.custom.color != blank %}
              <tr>
                <th scope="row">Color</th>
                <td>{{ product_item.metafields.custom.color.value | escape }}</td>
              </tr>
            {% endif %}

            {% if product_item.metafields.custom.fragrance_family != blank %}
              <tr>
                <th scope="row">Fragrance Family</th>
                <td>{{ product_item.metafields.custom.fragrance_family.value | escape }}</td>
              </tr>
            {% endif %}

            {% if product_item.metafields.custom.fragrance_subfamily != blank %}
              <tr>
                <th scope="row">Fragrance Subfamily</th>
                <td>{{ product_item.metafields.custom.fragrance_subfamily.value | escape }}</td>
              </tr>
            {% endif %} {% endcomment %}
          </tbody>
        </table>
      </div>
    {% else %}
      <p class="product-info-empty">
        {{ section.settings.empty_message | escape }}
      </p>
    {% endif %}
  </div>

  <div
    id="product-reviews-panel-{{ section.id }}"
    class="product-info-panel"
    role="tabpanel"
    data-panel="reviews"
    hidden
  >
    {% if section.settings.reviews_page != blank %}
      {{ section.settings.reviews_page.content }}
    {% else %}
      <p>
        Reviews can be displayed here using your review app's product review widget.
      </p>
    {% endif %}
  </div>
</section>

<style>
  #product-info-{{ section.id }} {
    margin: 30px 0;
    color: #555;
    font-size: 15px;
  }

  #product-info-{{ section.id }} .product-info-tab-header {
    display: flex;
    align-items: stretch;
    gap: 48px;
    border-bottom: 1px solid #e3e3e3;
    margin-bottom: 34px;
  }

  #product-info-{{ section.id }} .product-info-tab {
    appearance: none;
    border: 0;
    border-bottom: 3px solid transparent;
    background: transparent;
    padding: 0 0 10px;
    margin-bottom: -1px;
    color: #444;
    cursor: pointer;
    font: inherit;
    white-space: nowrap;
  }

  #product-info-{{ section.id }} .product-info-tab.active {
    color: #087b3d;
    border-bottom-color: #087b3d;
  }

  #product-info-{{ section.id }} .product-info-tab:focus-visible {
    outline: 2px solid #087b3d;
    outline-offset: 4px;
  }

  #product-info-{{ section.id }} .product-info-table-wrapper {
    width: 100%;
    overflow-x: auto;
  }

  #product-info-{{ section.id }} .product-info-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  #product-info-{{ section.id }} .product-info-table th,
  #product-info-{{ section.id }} .product-info-table td {
    border: 1px solid #dcd8d0;
    padding: 15px 20px;
    text-align: left;
    vertical-align: middle;
    overflow-wrap: anywhere;
  }

  #product-info-{{ section.id }} .product-info-table th {
    width: 62%;
    font-weight: 700;
    color: #555;
  }

  #product-info-{{ section.id }} .product-info-table td {
    font-weight: 400;
  }

  #product-info-{{ section.id }} .product-info-empty {
    padding: 16px 0;
  }

  #product-info-{{ section.id }} [hidden] {
    display: none !important;
  }

  @media screen and (max-width: 749px) {
    #product-info-{{ section.id }} .product-info-tab-header {
      gap: 24px;
      margin-bottom: 22px;
      overflow-x: auto;
    }

    #product-info-{{ section.id }} .product-info-table th,
    #product-info-{{ section.id }} .product-info-table td {
      padding: 12px 10px;
      font-size: 13px;
    }

    #product-info-{{ section.id }} .product-info-table th {
      width: 50%;
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('product-info-{{ section.id }}');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const tabs = root.querySelectorAll('.product-info-tab');
    const panels = root.querySelectorAll('.product-info-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const selected = tab.dataset.tab;

        tabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle('active', active);
          item.setAttribute('aria-selected', String(active));
          item.tabIndex = active ? 0 : -1;
        });

        panels.forEach((panel) => {
          panel.hidden = panel.dataset.panel !== selected;
        });
      });
    });

    tabs.forEach((tab, index) => {
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();

        const next = event.key === 'ArrowRight'
          ? (index + 1) % tabs.length
          : (index - 1 + tabs.length) % tabs.length;

        tabs[next].focus();
        tabs[next].click();
      });
    });

    tabs.forEach((tab, index) => {
      tab.tabIndex = index === 0 ? 0 : -1;
    });
  })();
</script>

{% schema %}
{
  "name": "Product additional info",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "additional_heading",
      "label": "Additional information heading",
      "default": "Additional information"
    },
    {
      "type": "text",
      "id": "reviews_heading",
      "label": "Reviews heading",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty information message",
      "default": "No additional information available."
    },
    {
      "type": "page",
      "id": "reviews_page",
      "label": "Optional reviews page"
    }
  ],
  "presets": [
    {
      "name": "Product additional info"
    }
  ]
}
{% endschema %}
