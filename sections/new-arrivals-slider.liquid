
{% liquid
  assign collection = section.settings.collection
%}

<section
  id="NewArrivals-{{ section.id }}"
  class="new-arrivals"
  style="
    --na-columns: {{ section.settings.columns_desktop }};
    --na-gap: {{ section.settings.card_gap }}px;
  "
>
  <div class="new-arrivals__header page-width">
    <div>
      <h2 class="new-arrivals__heading">
        {{ section.settings.heading | escape }}
      </h2>

      {% if section.settings.description != blank %}
        <p class="new-arrivals__description">
          {{ section.settings.description | escape }}
        </p>
      {% endif %}
    </div>

    {% if section.settings.show_view_all and collection != blank %}
      <a class="new-arrivals__view-all"
         href="{{ collection.url }}">
        View all
      </a>
    {% endif %}
  </div>

  {% if collection != blank and collection.products.size > 0 %}
    <div class="new-arrivals__container page-width">

      {% if section.settings.show_arrows %}
        <button
          type="button"
          class="new-arrivals__arrow new-arrivals__arrow--prev"
          aria-label="Previous products"
          data-na-prev
        >
          &#10094;
        </button>
      {% endif %}

      <div class="new-arrivals__track" data-na-track>
        {% for product in collection.products limit: section.settings.products_to_show %}
          <article class="new-arrivals__card">

            <a class="new-arrivals__image-link"
               href="{{ product.url }}">
              <div class="new-arrivals__image-wrapper">
                {% if product.featured_image %}
                  {{
                    product.featured_image
                    | image_url: width: 700
                    | image_tag:
                      class: 'new-arrivals__image',
                      loading: 'lazy',
                      widths: '250, 350, 500, 700',
                      alt: product.featured_image.alt
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'new-arrivals__placeholder' }}
                {% endif %}

                {% if section.settings.show_badge %}
                  {% if product.available == false %}
                    <span class="new-arrivals__badge">Sold out</span>
                  {% elsif product.compare_at_price > product.price %}
                    <span class="new-arrivals__badge">Sale</span>
                  {% else %}
                    <span class="new-arrivals__badge">New</span>
                  {% endif %}
                {% endif %}
              </div>
            </a>

            <div class="new-arrivals__info">
              {% if section.settings.show_vendor %}
                <p class="new-arrivals__vendor">
                  {{ product.vendor | escape }}
                </p>
              {% endif %}

              <a class="new-arrivals__title"
                 href="{{ product.url }}">
                {{ product.title | escape }}
              </a>

              <div class="new-arrivals__price">
                {% if product.compare_at_price > product.price %}
                  <span class="new-arrivals__sale-price">
                    {{ product.price | money }}
                  </span>
                  <s>{{ product.compare_at_price | money }}</s>
                {% else %}
                  <span>{{ product.price | money }}</span>
                {% endif %}
              </div>

              {% if section.settings.show_cart_button %}
                {% if product.available %}
                  {% if product.has_only_default_variant %}
                    {% form 'product', product, class: 'new-arrivals__form' %}
                      <input type="hidden" name="id"
                             value="{{ product.selected_or_first_available_variant.id }}">
                      <button type="submit"
                              name="add"
                              class="new-arrivals__cart">
                        Add to cart
                      </button>
                    {% endform %}
                  {% else %}
                    <a class="new-arrivals__cart"
                       href="{{ product.url }}">
                      Choose options
                    </a>
                  {% endif %}
                {% else %}
                  <button class="new-arrivals__cart"
                          type="button" disabled>
                    Sold out
                  </button>
                {% endif %}
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>

      {% if section.settings.show_arrows %}
        <button
          type="button"
          class="new-arrivals__arrow new-arrivals__arrow--next"
          aria-label="Next products"
          data-na-next
        >
          &#10095;
        </button>
      {% endif %}
    </div>
  {% else %}
    <div class="page-width">
      <p>Please select a product collection in this section's settings.</p>
    </div>
  {% endif %}
</section>

<style>
  #NewArrivals-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__heading {
    margin: 0;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.2;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__description {
    margin: 8px 0 0;
    color: #666;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__view-all {
    color: inherit;
    text-underline-offset: 4px;
    white-space: nowrap;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__container {
    position: relative;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc(
      (100% - (var(--na-columns) - 1) * var(--na-gap))
      / var(--na-columns)
    );
    gap: var(--na-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 2px 1px 12px;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__track::-webkit-scrollbar {
    display: none;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__card {
    min-width: 0;
    scroll-snap-align: start;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__image-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__image-wrapper {
    position: relative;
    overflow: hidden;
    background: #f6f6f6;
    border-radius: {{ section.settings.image_radius }}px;
    aspect-ratio: {% if section.settings.image_ratio == 'square' %}1 / 1{% elsif section.settings.image_ratio == 'portrait' %}3 / 4{% else %}4 / 3{% endif %};
  }

  #NewArrivals-{{ section.id }} .new-arrivals__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__image-link:hover .new-arrivals__image {
    transform: scale(1.04);
  }

  #NewArrivals-{{ section.id }} .new-arrivals__placeholder {
    width: 100%;
    height: 100%;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 5px 9px;
    background: #fff;
    color: #222;
    font-size: 12px;
    border-radius: 3px;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__info {
    padding-top: 12px;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__vendor {
    margin: 0 0 5px;
    color: #777;
    font-size: 12px;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__title {
    display: block;
    margin-bottom: 8px;
    color: inherit;
    text-decoration: none;
    font-size: 15px;
    line-height: 1.5;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__title:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__sale-price {
    color: #b42318;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__price s {
    color: #777;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__cart {
    display: block;
    width: 100%;
    margin-top: 12px;
    padding: 11px 12px;
    border: 1px solid #222;
    border-radius: {{ section.settings.button_radius }}px;
    background: #222;
    color: #fff;
    text-align: center;
    text-decoration: none;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__cart:hover {
    background: #444;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__cart:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__arrow {
    position: absolute;
    z-index: 2;
    top: 35%;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 1px solid #ddd;
    border-radius: 50%;
    background: #fff;
    color: #222;
    box-shadow: 0 2px 8px #00000012;
    cursor: pointer;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__arrow--prev {
    left: -16px;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__arrow--next {
    right: -16px;
  }

  #NewArrivals-{{ section.id }} .new-arrivals__arrow:hover {
    background: #222;
    color: #fff;
  }

  @media screen and (max-width: 749px) {
    #NewArrivals-{{ section.id }} .new-arrivals__header {
      margin-bottom: 20px;
    }

    #NewArrivals-{{ section.id }} .new-arrivals__heading {
      font-size: min({{ section.settings.heading_size }}px, 26px);
    }

    #NewArrivals-{{ section.id }} .new-arrivals__track {
      grid-auto-columns: 72%;
    }

    #NewArrivals-{{ section.id }} .new-arrivals__arrow {
      width: 32px;
      height: 32px;
      top: 32%;
    }

    #NewArrivals-{{ section.id }} .new-arrivals__arrow--prev {
      left: -8px;
    }

    #NewArrivals-{{ section.id }} .new-arrivals__arrow--next {
      right: -8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #NewArrivals-{{ section.id }} .new-arrivals__track,
    #NewArrivals-{{ section.id }} .new-arrivals__image {
      scroll-behavior: auto;
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('NewArrivals-{{ section.id }}');
    if (!root || root.dataset.naInitialized === 'true') return;

    root.dataset.naInitialized = 'true';

    const track = root.querySelector('[data-na-track]');
    const prev = root.querySelector('[data-na-prev]');
    const next = root.querySelector('[data-na-next]');

    if (!track) return;

    const slide = (direction) => {
      const card = track.querySelector('.new-arrivals__card');
      if (!card) return;

      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      const amount = card.getBoundingClientRect().width + gap;

      track.scrollBy({
        left: direction * amount,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ? 'auto'
          : 'smooth'
      });
    };

    if (prev) prev.addEventListener('click', () => slide(-1));
    if (next) next.addEventListener('click', () => slide(1));
  })();
</script>

{% schema %}
{
  "name": "New arrivals slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover our latest products."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Maximum products",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop products visible",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Space between products",
      "min": 8,
      "max": 32,
      "step": 2,
      "default": 20
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Product image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 8
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 48,
      "step": 2,
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show slider arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show New, Sale and Sold out badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_cart_button",
      "label": "Show Add to cart button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View all link",
      "default": true
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "New arrivals slider"
    }
  ]
}
{% endschema %}
