
{{ 'new-arrival.css' | asset_url | stylesheet_tag }}

{% liquid
  assign collection = section.settings.collection
%}

<section
  id="NewArrivals-{{ section.id }}"
  class="new-arrivals"
  style="
    --na-columns: {{ section.settings.columns_desktop }};
    --na-gap: {{ section.settings.card_gap }}px;
  "
>
  <div class="new-arrivals__header page-width">
    <div>
      <h2 class="new-arrivals__heading">
        {{ section.settings.heading | escape }}
      </h2>

      {% if section.settings.description != blank %}
        <p class="new-arrivals__description">
          {{ section.settings.description | escape }}
        </p>
      {% endif %}
    </div>

    {% if section.settings.show_view_all and collection != blank %}
      <a class="new-arrivals__view-all"
         href="{{ collection.url }}">
        View all
      </a>
    {% endif %}
  </div>

  {% if collection != blank and collection.products.size > 0 %}
    <div class="new-arrivals__container page-width">

      {% if section.settings.show_arrows %}
        <button
          type="button"
          class="new-arrivals__arrow new-arrivals__arrow--prev"
          aria-label="Previous products"
          data-na-prev
        >
          &#10094;
        </button>
      {% endif %}

      <div class="new-arrivals__track" data-na-track>
        {% for product in collection.products limit: section.settings.products_to_show %}
          <article class="new-arrivals__card">

            <a class="new-arrivals__image-link"
               href="{{ product.url }}">
              <div class="new-arrivals__image-wrapper">
                {% if product.featured_image %}
                  {{
                    product.featured_image
                    | image_url: width: 700
                    | image_tag:
                      class: 'new-arrivals__image',
                      loading: 'lazy',
                      widths: '250, 350, 500, 700',
                      alt: product.featured_image.alt
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'new-arrivals__placeholder' }}
                {% endif %}

                {% if section.settings.show_badge %}
                  {% if product.available == false %}
                    <span class="new-arrivals__badge">Sold out</span>
                  {% elsif product.compare_at_price > product.price %}
                    <span class="new-arrivals__badge">Sale</span>
                  {% else %}
                    <span class="new-arrivals__badge">New</span>
                  {% endif %}
                {% endif %}
              </div>
            </a>

            <div class="new-arrivals__info">
              {% if section.settings.show_vendor %}
                <p class="new-arrivals__vendor">
                  {{ product.vendor | escape }}
                </p>
              {% endif %}

              <a class="new-arrivals__title"
                 href="{{ product.url }}">
                {{ product.title | escape }}
              </a>

              <div class="new-arrivals__price">
                {% if product.compare_at_price > product.price %}
                  <span class="new-arrivals__sale-price">
                    {{ product.price | money }}
                  </span>
                  <s>{{ product.compare_at_price | money }}</s>
                {% else %}
                  <span>{{ product.price | money }}</span>
                {% endif %}
              </div>

              {% if section.settings.show_cart_button %}
                {% if product.available %}
                  {% if product.has_only_default_variant %}
                    {% form 'product', product, class: 'new-arrivals__form' %}
                      <input type="hidden" name="id"
                             value="{{ product.selected_or_first_available_variant.id }}">
                      <button type="submit"
                              name="add"
                              class="new-arrivals__cart">
                        Add to cart
                      </button>
                    {% endform %}
                  {% else %}
                    <a class="new-arrivals__cart"
                       href="{{ product.url }}">
                      Choose options
                    </a>
                  {% endif %}
                {% else %}
                  <button class="new-arrivals__cart"
                          type="button" disabled>
                    Sold out
                  </button>
                {% endif %}
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>

      {% if section.settings.show_arrows %}
        <button
          type="button"
          class="new-arrivals__arrow new-arrivals__arrow--next"
          aria-label="Next products"
          data-na-next
        >
          &#10095;
        </button>
      {% endif %}
    </div>
  {% else %}
    <div class="page-width">
      <p>Please select a product collection in this section's settings.</p>
    </div>
  {% endif %}
</section>



<script>
  (() => {
    const root = document.getElementById('NewArrivals-{{ section.id }}');
    if (!root || root.dataset.naInitialized === 'true') return;

    root.dataset.naInitialized = 'true';

    const track = root.querySelector('[data-na-track]');
    const prev = root.querySelector('[data-na-prev]');
    const next = root.querySelector('[data-na-next]');

    if (!track) return;

    const slide = (direction) => {
      const card = track.querySelector('.new-arrivals__card');
      if (!card) return;

      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      const amount = card.getBoundingClientRect().width + gap;

      track.scrollBy({
        left: direction * amount,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ? 'auto'
          : 'smooth'
      });
    };

    if (prev) prev.addEventListener('click', () => slide(-1));
    if (next) next.addEventListener('click', () => slide(1));
  })();
</script>

{% schema %}
{
  "name": "New arrivals slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover our latest products."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Maximum products",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop products visible",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Space between products",
      "min": 8,
      "max": 32,
      "step": 2,
      "default": 20
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Product image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 8
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 48,
      "step": 2,
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show slider arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show New, Sale and Sold out badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_cart_button",
      "label": "Show Add to cart button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View all link",
      "default": true
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "New arrivals slider"
    }
  ]
}
{% endschema %}
