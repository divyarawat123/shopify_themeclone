        "column8": {
          "type": "column",
          "settings": {
            "title": "",
            "text": "<p>The customised and personalised note of cocktails aroma candles used for Kettel one vodka brand campaign had a huge success across pan India distributors and client was overwhelmed to continue the campaign for Black label and Gold label scotch brands.</p><h3>Ms. Prajakta</h3>",
            "link_label": "",
            "link": ""
          }
        },
        "column9": {
          "type": "column",
          "settings": {
