        },
        "column10": {
          "type": "column",
          "settings": {
            "title": "",
            "text": "<p>The Diwali hampers curated by Tara candles had a fabulous demand after first supply of 1000 units it went to close at 10000 units due to overwhelming response from customers.</p><h3>Mr. Abhishek Karchuli</h3>",
            "link_label": "",
